# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Settings -> API). NUNCA commite o .env.local no git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada - usada SOMENTE no servidor (API routes). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp do dono, formato internacional sem símbolos
NEXT_PUBLIC_OWNER_WHATSAPP=5500000000000
NEXT_PUBLIC_OWNER_NAME=Anfitriao Dev
