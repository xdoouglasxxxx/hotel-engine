{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.*.local)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(vercel env:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(supabase db reset:*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./scripts/test-hooks.js)",
      "Write(./scripts/test-hooks.js)"
    ],
    "allow": [
      "Bash(git commit:*)",
      "Bash(git add *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(npm run dev*)",
      "Bash(npx eslint*)",
      "Bash(node scripts/*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(dir)",
      "Bash(dir *)",
      "Bash(Select-String *)",
      "Bash(mkdir *)",
      "Bash(Copy-Item *)",
      "Bash(Move-Item *)",
      "Bash(supabase migration new *)",
      "WebFetch(domain:localhost)",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm view:*)",
      "Bash(node -v:*)",
      "Bash(node --check:*)",
      "Bash(git branch:*)",
      "Bash(npm run typecheck)",
      "Bash(node scripts/test-hooks.js:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.js\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
